RESOLVER_NAME=myresolver
CERT_EMAIL=user@example.com

# Route53 DNS-01 credentials for the ACME resolver.
# The IAM principal MUST be able to write TXT records in EVERY hosted zone that
# this host serves certificates for.
# Required IAM actions: route53:GetChange, route53:ListHostedZones,
# route53:ListHostedZonesByName, route53:ChangeResourceRecordSets.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
# Do NOT set AWS_HOSTED_ZONE_ID. Leave it unset, and lego auto-detects the
# correct public hosted zone for each FQDN across every zone you serve.

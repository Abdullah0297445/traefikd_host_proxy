RESOLVER_NAME=myresolver
CERT_EMAIL=user@example.com

# Route53 DNS-01 credentials for the ACME resolver.
# The IAM principal MUST be able to write TXT records in EVERY hosted zone
# this box serves certs for (here: hirecinch.com AND carteblanche.tech).
# Required IAM actions: route53:GetChange, route53:ListHostedZones,
# route53:ListHostedZonesByName, route53:ChangeResourceRecordSets.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
# Do NOT set AWS_HOSTED_ZONE_ID — leaving it unset lets lego auto-detect the
# correct public hosted zone per FQDN across both zones.
